{
  "compilerOptions": {
     "module": "Node16",
     "jsx": "react-jsx",
     "noImplicitReturns": true,
     "noUnusedLocals": true,
     "outDir": "lib",
     "sourceMap": true,
     "strict": true,
     "target": "es2017",
     "skipLibCheck": true,
     "esModuleInterop": true,
     "moduleResolution": "node16",
     "paths": {
        "@core/*": ["../packages/core/src/*"]
     }
  },
  "compileOnSave": true,
  "include": ["src", "test"]
}

