{
  "compilerOptions": {
     "module": "Node16",
     "noImplicitReturns": true,
     "noUnusedLocals": true,
     "outDir": "lib",
     "sourceMap": true,
     "strict": true,
     "target": "es2017",
     "skipLibCheck": true,
     "esModuleInterop": true,
     "moduleResolution": "node16"
  },
  "compileOnSave": true,
  "include": ["src"]
}

