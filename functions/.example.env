# Copy to functions/.env (gitignored). Values here are read by the Cloud Functions at deploy time.

# Public URL of the store, used in e-mail links and as the return address after card payments
SITE_URL=https://shop.example.com

# Algolia search (optional). The write key is a secret: firebase functions:secrets:set ALGOLIA_API_WRITE_KEY
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_INDEX_NAME=products

# Order e-mails (Gmail SMTP with an app password). The password is a secret: firebase functions:secrets:set EMAIL_PASSWORD
EMAIL_USER=orders@example.com

# Card payments: switch a provider on only after setting its secrets with firebase functions:secrets:set
# (see the README section "Card payments")
ENABLE_STRIPE=false
ENABLE_NETOPIA=false

# Reject callable function requests without a valid App Check token (set up App Check in the storefront first)
ENFORCE_APP_CHECK=false
