# Copy to functions/.secret.local (gitignored) to run the Functions emulator.
# The emulator can't read Secret Manager for the offline demo project, so it takes the secrets from here.
# Placeholders are enough: in the emulator, search sync and e-mails are skipped, so demo data never reaches
# the real Algolia index or real inboxes.
EMAIL_PASSWORD=emulator-placeholder
ALGOLIA_API_WRITE_KEY=emulator-placeholder
