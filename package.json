{
  "name": "next-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:emulators": "node scripts/dev-emulators.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@14 emulators:exec --only firestore,storage --project demo-store \"vitest run -c vitest.rules.config.mts\"",
    "typecheck": "tsc --noEmit",
    "emulators": "npx --yes firebase-tools@14 emulators:start --project demo-store",
    "seed:demo": "npx --yes firebase-tools@14 emulators:exec --only auth,firestore,storage --project demo-store \"node scripts/seed-demo/seed.mjs --with-orders --admin-email admin@example.com\"",
    "seed:emulators": "node scripts/seed-demo/seed.mjs --with-orders --admin-email admin@example.com",
    "algolia:setup": "node scripts/algolia-setup.mjs",
    "algolia:reindex": "node scripts/algolia-reindex.mjs",
    "make-admin": "node scripts/make-admin.mjs"
  },
  "dependencies": {
    "@algolia/client-search": "^5.60.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "algoliasearch": "^5.60.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.488.0",
    "next": "^15.5.28",
    "next-intl": "^4.0.3",
    "phone": "^3.1.72",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-redux": "^9.3.0",
    "react-responsive-carousel": "^3.2.23",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "@grpc/grpc-js": "^1.14.6"
  }
