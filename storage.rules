rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAdmin() {
      return request.auth != null && request.auth.token.get('isAdmin', false) == true;
    }
    // Photos up to 5 MB, SVG icons and logos up to 200 KB
    function validImage() {
      return (request.resource.contentType.matches('image/(png|jpeg|webp|avif|gif)') && request.resource.size <= 5 * 1024 * 1024)
        || validSvg();
    }
    function validSvg() {
      return request.resource.contentType == 'image/svg+xml' && request.resource.size <= 200 * 1024;
    }
    // Default rule - deny all access unless explicitly allowed
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Everyone can open a file by its link; only admins can list folders, upload, replace and delete

    // Product images
    match /Products/{productId}/{allImages=**} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && validImage();
    }

    // Category images and icons
    match /Categories/Icons/{fileName} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && validSvg();
    }

    match /Categories/Images/{fileName} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && validImage();
    }

    // Brand logos
    match /Brands/{fileName} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && validImage();
    }

    // The store's logo, favicon and share image (Admin → Settings → Branding); favicons may also be .ico files
    match /Branding/{fileName} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && (validImage() || (request.resource.contentType.matches('image/(x-icon|vnd[.]microsoft[.]icon)') && request.resource.size <= 200 * 1024));
    }

    // Slides
    match /Slides/{fileName} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && validImage();
    }
  }
}
