# The store's name, address, contact details, shipping, languages, currency and branding are set in
# Admin → Settings, not here.

# Public URL of the store, used for canonical links, Open Graph tags and the sitemap.
# On Vercel it defaults to the production domain when left empty.
NEXT_PUBLIC_SITE_URL=https://your-store.example.com

# Client-side cache duration for Firestore queries, in minutes (defaults to 2)
NEXT_PUBLIC_CACHE_DURATION=2

NEXT_PUBLIC_APIKEY=Firebase-api-key
NEXT_PUBLIC_AUTHDOMAIN=Firebase-auth-domain
NEXT_PUBLIC_PROJECTID=Firebase-project-id
NEXT_PUBLIC_STORAGEBUCKET=Firebase-storage-bucket
NEXT_PUBLIC_MESSAGINGSENDERID=Firebase-messaging-sender-id
NEXT_PUBLIC_APPID=Firebase-app-id
NEXT_PUBLIC_MEASUREMENTID=Firebase-measurement-id

NEXT_PUBLIC_ALGOLIA_APP_ID=Algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=Algolia-search-key

# App Check (optional, recommended): a reCAPTCHA Enterprise site key registered for App Check in the Firebase console.
# Leave empty to run without App Check. See docs/SECURITY-SETUP.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Development only: a debug token added under App Check → Manage debug tokens. Ignored in production builds.
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Server only (never NEXT_PUBLIC_): a read-only service account key for server-rendered pages, the JSON or the JSON in base64.
# Needed before App Check can be enforced on Firestore. See docs/SECURITY-SETUP.md.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Local development against the Firebase emulators. Set by `npm run dev:emulators`; leave it unset here.
# NEXT_PUBLIC_USE_EMULATORS=true
