NEXT_PUBLIC_STORE_NAME=Store-name
# Public URL of the store, used for canonical links, Open Graph tags and the sitemap.
# On Vercel it defaults to the production domain when left empty.
NEXT_PUBLIC_SITE_URL=https://your-store.example.com
NEXT_PUBLIC_STORE_ADDRESS=Store-address
NEXT_PUBLIC_PHONE_NO=Store-phone-number
NEXT_PUBLIC_CONTACT_EMAIL=Store-contact-email
NEXT_PUBLIC_ORDERS_EMAIL=Store-orders-email
NEXT_PUBLIC_SUPPORT_EMAIL=Store-support-email
NEXT_PUBLIC_SEND_NEW_ORDER_MAILS=true
NEXT_PUBLIC_SEND_ORDER_STATUS_UPDATE_MAILS=false
NEXT_PUBLIC_SEND_CONFIRMATION_MAILS=true
NEXT_PUBLIC_DEFAULT_SHIPPING_PRICE=25
NEXT_PUBLIC_SHIPPING_THRESHOLD=500
NEXT_PUBLIC_SHIPPING_THRESHOLD_ENABLED=false

# Client-side cache duration for Firestore queries, in minutes (defaults to 2)
NEXT_PUBLIC_CACHE_DURATION=2

NEXT_PUBLIC_APIKEY=Firebase-api-key
NEXT_PUBLIC_AUTHDOMAIN=Firebase-auth-domain
NEXT_PUBLIC_DATABASEURL=Firebase-database-url
NEXT_PUBLIC_PROJECTID=Firebase-project-id
NEXT_PUBLIC_STORAGEBUCKET=Firebase-storage-bucket
NEXT_PUBLIC_MESSAGINGSENDERID=Firebase-messaging-sender-id
NEXT_PUBLIC_APPID=Firebase-app-id
NEXT_PUBLIC_MEASUREMENTID=Firebase-measurement-id

NEXT_PUBLIC_ALGOLIA_APP_ID=Algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=Algolia-search-key
